{
  "name": "personal-toolbox",
  "version": "2.1.4",
  "private": true,
  "description": "个人本地工具箱 - 饮水提醒 · 待办清单 · 番茄钟 · 记账助手",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8000 --configLoader runner",
    "electron": "electron .",
    "start": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:8000 && electron .\"",
    "test:async-state": "node scripts/verify-async-state-updates.cjs",
    "test:feishu-workflows": "node scripts/verify-feishu-finance-workflows.cjs",
    "test:feishu-agent": "node scripts/verify-feishu-agent.cjs",
    "test:feishu-formatting": "node scripts/verify-feishu-formatting.cjs",
    "eval:feishu-planner": "cross-env PROMPTFOO_CONFIG_DIR=.promptfoo promptfoo eval -c promptfooconfig.planner.yaml --no-cache",
    "eval:feishu-agent": "cross-env PROMPTFOO_CONFIG_DIR=.promptfoo promptfoo eval -c promptfooconfig.agent.yaml --no-cache",
    "eval:feishu": "npm run eval:feishu-planner && npm run eval:feishu-agent",
    "test:water-reminder": "node scripts/verify-water-reminder.cjs",
    "build": "vite build --configLoader runner",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:portable": "npm run build && node scripts/build-portable.cjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^17.4.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "promptfoo": "^0.122.0",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "local.personal.toolbox",
    "productName": "个人工具箱",
    "executableName": "个人工具箱",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/assets",
        "to": "assets",
        "filter": [
          "app.ico",
          "app.png"
        ]
      }
    ],
    "win": {
      "icon": "electron/assets/app.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "personal-toolbox-setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Xtttt14",
        "repo": "toolkit"
      }
    ],
    "portable": {
      "artifactName": "个人工具箱-${version}-${arch}.${ext}"
    }
  }
}
